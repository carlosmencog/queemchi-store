{% comment %}
  Queemchi home contact/order CTA.
{% endcomment %}

<section id="contacto" class="section padding-side qm-home-section qm-home-contact" data-qm-snap-section>
  <div class="spin-section over">
    <div class="half-section full">
      <div class="cta-heading-wrapper h">
        <div class="content-wrapper-page center-mobile">
          <div class="tag-wrapper">
            <div class="bullet-icon-purple"></div>
            <div>Empieza aquí</div>
          </div>
          <h2 class="heading-large">¿Listo para darle vida a tu comida? <br/></h2>
          <div class="div-block-2">
            {% render 'queemchi-cta', label: 'Haz tu pedido', href: order_url, tone: 'brand', target: '_blank', rel: 'noopener noreferrer' %}
          </div>
        </div>
      </div>
    </div>
    <div class="spin-wrapper-side inner">
      <div data-w-id="83c61644-4355-7f20-b0e7-39df7f7b555d" class="main-spin">
        <div data-w-id="83c61644-4355-7f20-b0e7-39df7f7b555f" class="spin-icon"><img src="{{ 'Group-49.png' | asset_url }}" loading="lazy" sizes="(max-width: 1585px) 100vw, 1585px" alt="" class="img-logo-rotate rotate-45"/></div>
          <div class="spin-icon"><img src="{{ 'Group-51.png' | asset_url }}" loading="lazy" sizes="(max-width: 1585px) 100vw, 1585px" alt="" class="img-logo-rotate"/></div>
        </div>
        <div class="s-row _90">
          <div class="spin-icon"><img src="{{ 'Group-48.png' | asset_url }}" loading="lazy" sizes="(max-width: 1585px) 100vw, 1585px" alt="" class="img-logo-rotate r45"/></div>
          <div class="spin-icon"><img src="{{ 'Group-47.png' | asset_url }}" loading="lazy" sizes="(max-width: 1585px) 100vw, 1585px" alt="" class="img-logo-rotate rotate-45"/></div>
        </div>
        <div class="s-row">
          <div class="spin-icon"><img src="{{ 'Group-44.png' | asset_url }}" loading="lazy" sizes="(max-width: 1600px) 100vw, 1600px" alt="" class="img-logo-rotate"/></div>
          <div class="spin-icon"><img src="{{ 'Group-45.png' | asset_url }}" loading="lazy" sizes="(max-width: 1600px) 100vw, 1600px" alt="" class="img-logo-rotate"/></div>
        </div>
        <div class="s-row-h">
          <div class="spin-icon"><img src="{{ 'Group-42.png' | asset_url }}" loading="lazy" sizes="(max-width: 1600px) 100vw, 1600px" alt="" class="img-logo-rotate"/></div>
          <div class="spin-icon"><img src="{{ 'Group-50.png' | asset_url }}" loading="lazy" sizes="(max-width: 1585px) 100vw, 1585px" alt="" class="img-logo-rotate"/></div>
        </div>
      </div>
    </div>
  </div>
</section>
